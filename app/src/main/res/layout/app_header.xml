<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="62dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="16dp">
        <ImageView android:id="@+id/app_icon"
            android:layout_width="33dp" android:layout_height="33dp" />
        <TextView android:id="@+id/app_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="16dp" android:textSize="20sp"
            android:textColor="#ffffff" android:singleLine="true" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent" android:layout_height="4dp"
        android:layout_marginLeft="16dp" android:layout_marginRight="16dp">
        <View android:id="@+id/header_line"
            android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:background="#555555" />
        <ProgressBar android:id="@+id/header_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="12dp"
            android:minHeight="4dp" android:maxHeight="4dp"
            android:padding="0dp" android:indeterminate="true"
            android:layout_gravity="center_vertical"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
